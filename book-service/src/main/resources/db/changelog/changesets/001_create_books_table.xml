<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001" author="xpap">
        <comment>Create the initial table schema</comment>
        <createTable tableName="books">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="author" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="isbn" type="varchar(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="genre" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(1000)"/>
            <column name="available_copies" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="year_publication" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
        </createTable>
    </changeSet>

</databaseChangeLog>